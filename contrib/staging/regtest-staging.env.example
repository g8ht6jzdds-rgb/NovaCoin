# Copy to /etc/novacoin/regtest-staging.env, owner root:novacoin, mode 0600.
# The immutable source revision is embedded as an OCI image label.
NOVACOIN_SOURCE_REVISION=REPLACE_WITH_IMMUTABLE_40_HEX_SOURCE_REVISION
# Use a host secret manager where available. Do not commit populated files.
NOVACOIN_NODE_NAME=REPLACE_WITH_STAGING_NODE_ALIAS
NOVACOIN_RPC_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
NOVACOIN_WALLET_PASSPHRASE=REPLACE_WITH_GENERATED_WALLET_PASSPHRASE
NOVACOIN_IMAGE_TAG=REPLACE_WITH_IMMUTABLE_CANDIDATE_TAG
NOVACOIN_BASE_IMAGE=debian@sha256:REPLACE_WITH_REVIEWED_BASE_IMAGE_DIGEST
NOVACOIN_REGTEST_DATA_DIR=/srv/novacoin/regtest/data
NOVACOIN_REGTEST_LOG_DIR=/srv/novacoin/regtest/log
