[Unit]
Description=NovaCoin TESTNET node (pre-approval template)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=novacoin
Group=novacoin
EnvironmentFile=/etc/novacoin/testnet.env
ExecStart=/usr/local/bin/novacoind --testnet --name ${NOVACOIN_NODE_NAME} --datadir /var/lib/novacoin/testnet --logfile /var/log/novacoin/testnet.log --p2pport 28333 --p2pbind 0.0.0.0 --rpcport 28332
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/novacoin/testnet /var/log/novacoin
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
