# Copy to /etc/novacoin/testnet.env (mode 0600, owner root:novacoin) or inject
# with a secret manager. Do not commit the populated file.
NOVACOIN_NODE_NAME=REPLACE_WITH_OPERATOR_NODE_NAME
NOVACOIN_RPC_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_RPC_SECRET
NOVACOIN_EXPLORER_RPC_PASSWORD=REPLACE_WITH_DISTINCT_READ_ONLY_RPC_SECRET
# Only configure on the isolated faucet host, never a seed or explorer host.
NOVACOIN_FAUCET_RPC_PASSWORD=REPLACE_WITH_DISTINCT_FAUCET_RPC_SECRET
NOVACOIN_FAUCET_MAX_PAYOUT=REPLACE_WITH_INTEGER_BASE_UNITS
NOVACOIN_WALLET_PASSPHRASE=REPLACE_WITH_GENERATED_WALLET_PASSPHRASE

# docker-compose only: host paths must be absolute and outside the container.
NOVACOIN_IMAGE_TAG=REPLACE_WITH_IMMUTABLE_RELEASE_TAG
NOVACOIN_TESTNET_P2P_PORT=28333
NOVACOIN_TESTNET_DATA_DIR=/srv/novacoin/testnet/data
NOVACOIN_TESTNET_LOG_DIR=/srv/novacoin/testnet/log
