cmake_minimum_required(VERSION 3.25)

include(${CMAKE_CURRENT_LIST_DIR}/read-version.cmake)
nova_validate_version("${APP_VERSION}")
foreach(field COMPILER TARGET_PLATFORM BUILD_CONFIGURATION)
    if(NOT DEFINED ${field} OR "${${field}}" STREQUAL "")
        set(${field} "UNRECORDED")
    endif()
    if(NOT "${${field}}" MATCHES "^[A-Za-z0-9_.+-]+$")
        message(FATAL_ERROR "Invalid public build metadata field")
    endif()
endforeach()
if(NOT DEFINED BUILD_EPOCH)
    set(BUILD_EPOCH "")
endif()
if(NOT BUILD_EPOCH STREQUAL "")
    if(NOT BUILD_EPOCH MATCHES "^(0|[1-9][0-9]*)$" OR
       BUILD_EPOCH GREATER 253402300799)
        message(FATAL_ERROR "SOURCE_DATE_EPOCH must be a canonical UTC Unix second")
    endif()
endif()
function(check_hash value)
    string(LENGTH "${value}" size)
    if(NOT size EQUAL 40 OR NOT value MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Source identity must be 40 lowercase hexadecimal characters")
    endif()
endfunction()

set(revision "UNRECORDED")
set(tree "UNRECORDED")
set(state "unknown")
find_program(git NAMES git)
set(is_checkout FALSE)
if(git)
    execute_process(COMMAND "${git}" rev-parse --show-toplevel
        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE result
        OUTPUT_VARIABLE root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
    file(REAL_PATH "${SOURCE_DIR}" source_root)
    if(result EQUAL 0)
        file(REAL_PATH "${root}" git_root)
        if(source_root STREQUAL git_root)
            set(is_checkout TRUE)
        endif()
    endif()
endif()
if(EXISTS "${SOURCE_DIR}/.git" AND NOT is_checkout)
    message(FATAL_ERROR "Git metadata exists but checkout provenance is unavailable")
endif()
if(is_checkout)
    if(NOT "${ARCHIVE_REVISION}" STREQUAL "" OR NOT "${ARCHIVE_TREE}" STREQUAL "")
        message(FATAL_ERROR "Archive identity cannot override a Git checkout")
    endif()
    execute_process(COMMAND "${git}" rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE rev_result OUTPUT_VARIABLE revision
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
    execute_process(COMMAND "${git}" rev-parse "HEAD^{tree}" WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE tree_result OUTPUT_VARIABLE tree
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
    execute_process(COMMAND "${git}" status --porcelain --untracked-files=normal
        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE status_result
        OUTPUT_VARIABLE changes ERROR_QUIET TIMEOUT 10)
    if(NOT rev_result EQUAL 0 OR NOT tree_result EQUAL 0 OR NOT status_result EQUAL 0)
        message(FATAL_ERROR "Cannot determine checkout provenance")
    endif()
    check_hash("${revision}")
    check_hash("${tree}")
    set(state "clean")
    if(NOT changes STREQUAL "")
        set(state "dirty")
    endif()
elseif(NOT "${ARCHIVE_REVISION}" STREQUAL "" OR NOT "${ARCHIVE_TREE}" STREQUAL "")
    check_hash("${ARCHIVE_REVISION}")
    check_hash("${ARCHIVE_TREE}")
    set(revision "${ARCHIVE_REVISION}")
    set(tree "${ARCHIVE_TREE}")
    set(state "archive-declared")
endif()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
set(content "#pragma once\n#include <string_view>\nnamespace nova::build {\ninline constexpr std::string_view kApplicationVersion = \"${APP_VERSION}\";\ninline constexpr std::string_view kSourceRevision = \"${revision}\";\ninline constexpr std::string_view kSourceTree = \"${tree}\";\ninline constexpr std::string_view kSourceState = \"${state}\";\ninline constexpr std::string_view kCompiler = \"${COMPILER}\";\ninline constexpr std::string_view kTargetPlatform = \"${TARGET_PLATFORM}\";\ninline constexpr std::string_view kBuildConfiguration = \"${BUILD_CONFIGURATION}\";\ninline constexpr std::string_view kBuildTimestamp = \"${BUILD_EPOCH}\";\n}\n")
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
