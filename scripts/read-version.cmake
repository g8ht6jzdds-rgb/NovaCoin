# Single SemVer grammar shared by configure and the per-build provenance writer.
function(nova_validate_version value)
    string(LENGTH "${value}" version_length)
    if(version_length GREATER 128)
        message(FATAL_ERROR "Semantic application version exceeds 128 characters")
    endif()
    if(NOT "${value}" MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
        message(FATAL_ERROR "Invalid semantic application version")
    endif()
    string(REGEX REPLACE "\\+.*$" "" without_build "${value}")
    if(without_build MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+-(.*)$")
        string(REPLACE "." ";" identifiers "${CMAKE_MATCH_1}")
        foreach(identifier IN LISTS identifiers)
            if(identifier MATCHES "^0[0-9]+$")
                message(FATAL_ERROR "Numeric prerelease identifiers must not have leading zeroes")
            endif()
        endforeach()
    endif()
endfunction()
