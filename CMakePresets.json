{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vcpkg-debug",
      "inherits": "debug",
      "displayName": "Debug (pinned vcpkg)",
      "binaryDir": "${sourceDir}/build/vcpkg-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg-release",
      "inherits": "release",
      "displayName": "Release (pinned vcpkg)",
      "binaryDir": "${sourceDir}/build/vcpkg-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "RelWithDebInfo with AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NOVA_ENABLE_SANITIZERS": "ON",
        "NOVA_ENABLE_ADDRESS_SANITIZER": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "RelWithDebInfo with UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NOVA_ENABLE_SANITIZERS": "ON",
        "NOVA_ENABLE_UNDEFINED_BEHAVIOR_SANITIZER": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "RelWithDebInfo libFuzzer with ASan and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF",
        "NOVA_ENABLE_SANITIZERS": "ON",
        "NOVA_ENABLE_ADDRESS_SANITIZER": "ON",
        "NOVA_ENABLE_UNDEFINED_BEHAVIOR_SANITIZER": "ON",
        "NOVA_SANITIZER_STATIC_RUNTIME": "ON",
        "NOVA_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "vcpkg-debug", "configurePreset": "vcpkg-debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "vcpkg-release", "configurePreset": "vcpkg-release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vcpkg-debug",
      "configurePreset": "vcpkg-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
